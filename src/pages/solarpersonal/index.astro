---
import StudioLayout from '../../layouts/StudioLayout.astro';
---

<StudioLayout title="Solar Personal App — Calculadora Fotovoltaica | appjava.dev">
  <main class="max-w-5xl mx-auto px-6 py-12 flex flex-col min-h-screen justify-between relative z-10">
    <nav class="flex justify-between items-center mb-12">
      <a href="/" class="text-xs font-black uppercase tracking-wider text-zinc-400 hover:text-white">← Volver al Portal</a>
      <div class="bg-zinc-800 p-1 rounded-full flex gap-1 text-[11px] font-bold text-zinc-300">
        <button class="lang-btn px-3 py-1 rounded-full" data-target="es">ES</button>
        <button class="lang-btn px-3 py-1 rounded-full" data-target="en">EN</button>
      </div>
    </nav>

    <section class="bg-gradient-to-br from-amber-950 via-zinc-900 to-zinc-900 border border-amber-500/30 p-8 md:p-16 rounded-[40px] space-y-8 shadow-2xl">
      <div class="space-y-3">
        <span class="text-xs font-black uppercase tracking-widest text-amber-400">Energía Sostenible</span>
        <h1 class="text-4xl md:text-6xl font-black uppercase text-white">Solar Personal App</h1>
      </div>

      <p class="text-zinc-300 text-lg leading-relaxed font-medium">
        <span data-lang-es>Herramienta para el cálculo y dimensionamiento energético de sistemas solares fotovoltaicos domiciliarios. Permite estimar requerimientos de paneles, baterías e inversores para acelerar la transición hacia la independencia energética.</span>
        <span data-lang-en>Application for energy sizing of domestic solar photovoltaic systems. Estimates panel, battery, and inverter requirements to accelerate energy independence.</span>
      </p>

      <div class="flex flex-wrap gap-4 pt-4">
        <a href="https://solarpersonal.web.app/" target="_blank" class="px-8 py-3.5 bg-white text-zinc-950 rounded-2xl font-black text-xs uppercase tracking-wider hover:bg-amber-100 transition shadow-lg">
          <span data-lang-es>Abrir Calculadora Solar ↗</span>
          <span data-lang-en>Launch Solar Calculator ↗</span>
        </a>
      </div>
    </section>

    <footer class="mt-16 pt-8 border-t border-zinc-800 text-xs text-zinc-500 font-bold uppercase flex justify-between">
      <p>© 2026 appjava.dev • Solar Personal</p>
      <a href="/" class="hover:text-white">appjava.dev</a>
    </footer>
  </main>
</StudioLayout>