---
import StudioLayout from '../../layouts/StudioLayout.astro';
---

<StudioLayout 
  title="EchoHome IoT Center — Hábitat Sustentable & Domótica Ecológica | appjava.dev"
  description="Modelo de hábitat ecológicamente confortable. Integración de agroecología, microredes de energías renovables y servidor local domótico libre de la nube."
>
  <main class="max-w-6xl mx-auto px-6 py-12 flex flex-col gap-24 relative z-10 text-zinc-100">
    
    <!-- HEADER Y NAVEGACIÓN -->
    <nav class="flex justify-between items-center py-4 border-b border-zinc-800">
      <a href="/" class="text-xs font-black uppercase tracking-wider text-zinc-400 hover:text-white transition flex items-center gap-2">
        <span>←</span>
        <span data-lang-es>Volver al Portal appjava.dev</span>
        <span data-lang-en>Back to appjava.dev Portal</span>
      </a>

      <div class="bg-zinc-900 p-1 rounded-full flex gap-1 border border-zinc-800 text-[11px] font-bold text-zinc-300">
        <button class="lang-btn px-3 py-1 rounded-full transition-all duration-300" data-target="es">ES</button>
        <button class="lang-btn px-3 py-1 rounded-full transition-all duration-300" data-target="en">EN</button>
      </div>
    </nav>

    <!-- HERO DE ECHOHOME -->
    <section class="bg-gradient-to-br from-teal-950/90 via-zinc-900 to-zinc-900 border border-teal-500/30 p-8 md:p-14 rounded-[40px] shadow-2xl relative overflow-hidden space-y-8">
      <div class="space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-500/10 border border-teal-500/20 text-teal-300 text-xs font-black uppercase tracking-widest">
          🌿 Hábitat Ecológicamente Confortable
        </div>
        
        <h1 class="text-4xl md:text-6xl font-black uppercase text-white tracking-tight">EchoHome IoT Center</h1>
        
        <p class="text-2xl font-bold text-teal-200 max-w-3xl">
          <span data-lang-es>Un modelo integral que une agroecología, domótica local y energías renovables.</span>
          <span data-lang-en>A comprehensive habitat model uniting agroecology, local domotics, and clean energy.</span>
        </p>
      </div>

      <p class="text-zinc-300 text-base leading-relaxed font-medium max-w-3xl">
        <span data-lang-es>
          EchoHome demuestra que la vida sustentable no requiere renunciar al confort moderno. Mediante la integración de paneles solares, micro-turbinas, recolección de agua pluvial y un servidor local en Python y Termux, logramos viviendas inteligentes autosuficientes que no dependen de servidores corporativos en la nube.
        </span>
        <span data-lang-en>
          EchoHome proves that sustainable living requires no sacrifice of modern comfort. By combining solar panels, micro-turbines, rainwater harvesting, and a local Python/Termux server, we build self-sufficient homes free from corporate cloud dependencies.
        </span>
      </p>

      <!-- MÉTRICAS DE IMPACTO COMPROBADO -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4">
        <div class="p-6 rounded-3xl bg-black/40 border border-teal-500/20 text-center space-y-1">
          <p class="text-4xl font-black text-teal-400">75%</p>
          <p class="text-xs font-black uppercase tracking-wider text-zinc-300">
            <span data-lang-es>Reducción Consumo Energético</span><span data-lang-en>Energy Consumption Reduction</span>
          </p>
        </div>
        <div class="p-6 rounded-3xl bg-black/40 border border-teal-500/20 text-center space-y-1">
          <p class="text-4xl font-black text-emerald-400">50%</p>
          <p class="text-xs font-black uppercase tracking-wider text-zinc-300">
            <span data-lang-es>Ahorro en Servicios Públicos</span><span data-lang-en>Utility Cost Savings</span>
          </p>
        </div>
        <div class="p-6 rounded-3xl bg-black/40 border border-teal-500/20 text-center space-y-1">
          <p class="text-4xl font-black text-amber-400">100%</p>
          <p class="text-xs font-black uppercase tracking-wider text-zinc-300">
            <span data-lang-es>Fuentes de Energía Renovable</span><span data-lang-en>Renewable Energy Sources</span>
          </p>
        </div>
      </div>

      <div class="flex flex-wrap gap-4 pt-4">
        <a href="https://echohome.pages.dev/" target="_blank" class="px-8 py-4 bg-teal-400 text-zinc-950 rounded-2xl font-black text-xs uppercase tracking-wider hover:bg-teal-300 transition shadow-lg">
          <span data-lang-es>Acceder al Modelo EchoHome ↗</span><span data-lang-en>Launch EchoHome Model ↗</span>
        </a>
        <a href="mailto:projects.appjavadev@gmail.com?subject=Consultoria%20de%20Habitat%20Sustentable%20EchoHome" class="px-8 py-4 bg-zinc-900 border border-zinc-700 text-white rounded-2xl font-black text-xs uppercase tracking-wider hover:bg-zinc-800 transition">
          <span data-lang-es>Solicitar Consultoría de Hábitat ↗</span><span data-lang-en>Request Habitat Consulting ↗</span>
        </a>
      </div>
    </section>

    <!-- FOOTER AGNÓSTICO -->
    <footer class="pt-12 border-t border-zinc-800 flex flex-col md:flex-row justify-between items-center gap-6 text-xs text-zinc-500">
      <p>© 2026 appjava.dev. Todos los derechos reservados.</p>
      <a href="/" class="hover:text-white transition">appjava.dev</a>
    </footer>

  </main>
</StudioLayout>

<script is:inline>
  function setupLangToggle() {
    const savedLang = localStorage.getItem('appjava_lang') || 'es';
    
    function updateUI(lang) {
      document.documentElement.setAttribute('data-lang', lang);
      document.querySelectorAll('.lang-btn').forEach(btn => {
        const target = btn.getAttribute('data-target');
        if (target === lang) {
          btn.classList.add('bg-teal-600', 'text-white');
          btn.classList.remove('text-zinc-400');
        } else {
          btn.classList.remove('bg-teal-600', 'text-white');
          btn.classList.add('text-zinc-400');
        }
      });
    }

    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-target');
        localStorage.setItem('appjava_lang', lang);
        updateUI(lang);
      });
    });

    updateUI(savedLang);
  }

  setupLangToggle();
</script>