---
import SofiLayout from '../../layouts/SofiLayout.astro';
---

<SofiLayout 
  title="SofiGrades — Calculadora de Promedios & Salvador de Becas | appjava.dev"
  description="El GPS académico definitivo para estudiantes universitarios. Calcula tus promedios por créditos, visualiza tus Puntos Asegurados y activa el Modo Supervivencia para pasar tus exámenes sin estrés."
>
  <!-- FONDO OBSIDIANA OSCURO CON DEGRADADO ESMERALDA -->
  <main class="max-w-6xl mx-auto px-6 py-12 flex flex-col gap-24 relative z-10 text-zinc-100">
    
    <!-- HEADER Y CONMUTADOR BILINGÜE -->
    <nav class="flex justify-between items-center py-4 border-b border-zinc-800">
      <a href="/" class="text-xs font-black uppercase tracking-wider text-zinc-400 hover:text-white transition flex items-center gap-2">
        <span>←</span>
        <span data-lang-es>Volver al Portal appjava.dev</span>
        <span data-lang-en>Back to appjava.dev Portal</span>
      </a>

      <div class="bg-zinc-900 p-1 rounded-full flex gap-1 border border-zinc-800 text-[11px] font-bold text-zinc-300">
        <button class="lang-btn px-3 py-1 rounded-full transition-all duration-300" data-target="es">ES</button>
        <button class="lang-btn px-3 py-1 rounded-full transition-all duration-300" data-target="en">EN</button>
      </div>
    </nav>

    <!-- HERO PRINCIPAL DE SOFIGRADES -->
    <section class="bg-gradient-to-br from-emerald-950/90 via-zinc-900 to-zinc-900 border border-emerald-500/30 p-8 md:p-14 rounded-[40px] shadow-2xl relative overflow-hidden">
      <div class="grid md:grid-cols-12 gap-12 items-center relative z-10">
        
        <!-- COLUMNA TEXTO Y VALOR EMOCIONAL -->
        <div class="md:col-span-6 space-y-8">
          <div class="flex items-center space-x-4">
            <div class="w-16 h-16 bg-gradient-to-tr from-emerald-600 to-teal-400 rounded-2xl flex items-center justify-center text-3xl font-black shadow-lg shadow-emerald-500/30">
              🎓
            </div>
            <div>
              <h1 class="text-4xl md:text-5xl font-black tracking-tighter uppercase leading-none text-white">SofiGrades</h1>
              <p class="text-xs font-black uppercase tracking-widest text-emerald-400 mt-1">
                <span data-lang-es>GPS Académico & Salvador de Becas</span>
                <span data-lang-en>Academic GPS & Scholarship Saver</span>
              </p>
            </div>
          </div>

          <p class="text-2xl md:text-3xl font-bold tracking-tight text-emerald-200 leading-tight">
            <span data-lang-es>Calcula tu promedio por créditos. Descubre exactamente qué nota necesitas para salvar la materia.</span>
            <span data-lang-en>Calculate your weighted GPA. Discover the exact grade you need to pass every course.</span>
          </p>

          <p class="text-base font-medium leading-relaxed text-zinc-300">
            <span data-lang-es>
              No es un bloc de notas común. SofiGrades es un calculador predictivo que calcula tus Puntos Asegurados en tiempo real. Si tu promedio baja de la meta de tu beca, activa automáticamente el Modo Supervivencia para proyectarte qué nota necesitas sacarle a los exámenes finales para pasar con tranquilidad.
            </span>
            <span data-lang-en>
              Not an ordinary notepad. SofiGrades is a predictive calculator tracking your Secured Points in real time. If your GPA drops below your scholarship target, it switches to Survival Mode to project the exact score needed on remaining exams.
            </span>
          </p>

          <!-- TIENDAS DE DESCARGA OFICIAL -->
          <div class="space-y-4 pt-2">
            <p class="text-xs font-black uppercase tracking-wider text-emerald-300">
              <span data-lang-es>🔥 Disponible para descarga inmediata:</span>
              <span data-lang-en>🔥 Available for immediate download:</span>
            </p>
            <div class="flex flex-wrap gap-4 items-center">
              <a href="https://appgallery.cloud.huawei.com/ag/n/app/C117722731" target="_blank" class="hover:scale-105 transition">
                <img src="/badges/huawei.png" alt="Huawei AppGallery" class="h-11 w-auto rounded-lg shadow-lg" />
              </a>
              <a href="https://www.amazon.com/gp/product/B0H1DM938C" target="_blank" class="hover:scale-105 transition">
                <img src="/badges/amazon.png" alt="Amazon Appstore" class="h-11 w-auto rounded-lg shadow-lg" />
              </a>
              <a href="https://apps.microsoft.com/store/detail/9P5G4FND54F4" target="_blank" class="hover:scale-105 transition">
                <img src="/badges/microsoft.png" alt="Microsoft Store" class="h-11 w-auto rounded-lg shadow-lg" />
              </a>

              <!-- GOOGLE PLAY EN PRUEBAS CERRADAS -->
              <div class="opacity-40 grayscale select-none cursor-help hover:opacity-60 transition duration-300" title="Próximamente en Google Play (Fase de Pruebas Cerradas con Testers)">
                <img src="/badges/google-play.png" alt="Get it on Google Play (Próximamente)" class="h-11 w-auto rounded-lg shadow-md" />
              </div>
            </div>
          </div>
        </div>

        <!-- SIMULADOR INTERACTIVO DE PANTALLA DE SOFIGRADES -->
        <div class="md:col-span-6 flex flex-col items-center justify-center">
          <div class="relative mx-auto border-zinc-800 bg-zinc-950 border-[12px] rounded-[48px] h-[520px] w-[260px] shadow-2xl overflow-hidden ring-1 ring-white/20">
            <div class="absolute top-2 left-1/2 -translate-x-1/2 h-4 w-20 bg-black rounded-full z-30"></div>
            
            <div class="rounded-[36px] overflow-hidden w-full h-full bg-zinc-900 relative">
              <img src="/assets/screenshots/dashboard.png" id="screen-dashboard" class="screen-img absolute inset-0 w-full h-full object-cover transition-opacity duration-300 opacity-100 z-10" alt="SofiGrades Dashboard" />
              <img src="/assets/screenshots/add-expense.png" id="screen-survival" class="screen-img absolute inset-0 w-full h-full object-cover transition-opacity duration-300 opacity-0 z-10" alt="Modo Supervivencia" />
              <img src="/assets/screenshots/study-log.png" id="screen-focus" class="screen-img absolute inset-0 w-full h-full object-cover transition-opacity duration-300 opacity-0 z-10" alt="Racha de Enfoque" />
              <img src="/assets/screenshots/backup.png" id="screen-backup" class="screen-img absolute inset-0 w-full h-full object-cover transition-opacity duration-300 opacity-0 z-10" alt="Respaldos" />
            </div>
          </div>

          <!-- BOTONES DEL SIMULADOR -->
          <div class="flex flex-wrap justify-center gap-2 mt-6 bg-black/60 p-1.5 rounded-full border border-white/10">
            <button class="screen-trigger px-3 py-1 bg-white text-zinc-950 text-xs font-bold rounded-full transition" data-target="dashboard">
              <span data-lang-es>Promedios</span><span data-lang-en>GPA Overview</span>
            </button>
            <button class="screen-trigger px-3 py-1 bg-white/10 text-white text-xs font-bold rounded-full transition" data-target="survival">
              <span data-lang-es>Supervivencia</span><span data-lang-en>Survival Mode</span>
            </button>
            <button class="screen-trigger px-3 py-1 bg-white/10 text-white text-xs font-bold rounded-full transition" data-target="focus">
              <span data-lang-es>Enfoque</span><span data-lang-en>Focus Streak</span>
            </button>
            <button class="screen-trigger px-3 py-1 bg-white/10 text-white text-xs font-bold rounded-full transition" data-target="backup">
              <span data-lang-es>Exportar PDF</span><span data-lang-en>PDF Export</span>
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- BENEFICIOS REALES PARA EL ESTUDIANTE -->
    <section class="space-y-10">
      <div class="border-b border-zinc-800 pb-6 space-y-2">
        <p class="text-xs font-black uppercase tracking-widest text-emerald-400">
          <span data-lang-es>Tranquilidad en Época de Exámenes</span>
          <span data-lang-en>Peace of Mind During Final Exams</span>
        </p>
        <h2 class="text-3xl md:text-5xl font-black uppercase tracking-tight text-white">
          <span data-lang-es>¿Por qué SofiGrades es tu Mejor Aliado Académico?</span>
          <span data-lang-en>Why SofiGrades is Your Best Academic Ally</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        
        <!-- BENEFICIO 1 -->
        <div class="p-8 rounded-3xl bg-zinc-900 border border-zinc-800 space-y-4 shadow-xl">
          <div class="w-12 h-12 bg-emerald-500/10 border border-emerald-500/20 rounded-2xl flex items-center justify-center text-2xl text-emerald-400 font-bold">
            📊
          </div>
          <h3 class="text-xl font-black uppercase text-white">
            <span data-lang-es>Puntos Asegurados</span>
            <span data-lang-en>Secured Points</span>
          </h3>
          <p class="text-sm text-zinc-300 leading-relaxed font-medium">
            <span data-lang-es>
              Visualiza en un tarjetón destacado los puntos reales que llevas acumulados en el semestre antes de presentar el examen final, sin falsas expectativas.
            </span>
            <span data-lang-en>
              Track real points accumulated so far in the semester before taking final exams, eliminating false expectations.
            </span>
          </p>
        </div>

        <!-- BENEFICIO 2 -->
        <div class="p-8 rounded-3xl bg-zinc-900 border border-zinc-800 space-y-4 shadow-xl">
          <div class="w-12 h-12 bg-teal-500/10 border border-teal-500/20 rounded-2xl flex items-center justify-center text-2xl text-teal-400 font-bold">
            🚨
          </div>
          <h3 class="text-xl font-black uppercase text-white">
            <span data-lang-es>Modo Supervivencia</span>
            <span data-lang-en>Survival Mode</span>
          </h3>
          <p class="text-sm text-zinc-300 leading-relaxed font-medium">
            <span data-lang-es>
              Si tu promedio cae por debajo de la meta de tu beca, la app cambia de marcha automáticamente y te calcula qué nota necesitas sacarle a las evaluaciones restantes para pasar la materia.
            </span>
            <span data-lang-en>
              If your GPA drops below your scholarship target, the app automatically calculates the exact required score on remaining evaluations to pass the course.
            </span>
          </p>
        </div>

        <!-- BENEFICIO 3 -->
        <div class="p-8 rounded-3xl bg-zinc-900 border border-zinc-800 space-y-4 shadow-xl">
          <div class="w-12 h-12 bg-green-500/10 border border-green-500/20 rounded-2xl flex items-center justify-center text-2xl text-green-400 font-bold">
            🟢
          </div>
          <h3 class="text-xl font-black uppercase text-white">
            <span data-lang-es>Semáforo Empático</span>
            <span data-lang-en>Empathetic Traffic Light</span>
          </h3>
          <p class="text-sm text-zinc-300 leading-relaxed font-medium">
            <span data-lang-es>
              Si la nota necesaria para salvar la materia es baja (ej. un 2.0), la pantalla se tiñe de verde esmeralda para transmitir tranquilidad psicológica y evitar alertas rojas innecesarias.
            </span>
            <span data-lang-en>
              If the grade required to pass is easily achievable (e.g. 2.0), the card turns emerald green to transmit psychological calm and eliminate false alarms.
            </span>
          </p>
        </div>

      </div>
    </section>

    <!-- AUTOBALANCEO Y ENFOQUE DIARIO -->
    <section class="bg-gradient-to-r from-zinc-900 via-zinc-900 to-emerald-950/40 rounded-[36px] p-8 md:p-12 border border-zinc-800 space-y-8 shadow-2xl">
      <div class="max-w-2xl space-y-3">
        <span class="text-xs font-black uppercase tracking-widest text-emerald-400">
          <span data-lang-es>Inteligencia Académica sin Esfuerzo</span>
          <span data-lang-en>Effortless Academic Intelligence</span>
        </span>
        <h2 class="text-3xl md:text-4xl font-black uppercase text-white">
          <span data-lang-es>Autobalanceo de Porcentajes & Racha de Enfoque</span>
          <span data-lang-en>Automatic Percentage Balancing & Focus Streak</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8 text-sm font-medium">
        <div class="space-y-2">
          <p class="font-bold text-white flex items-center gap-2">
            <span>⚖️</span>
            <span data-lang-es>Ponderación Automática por Créditos</span>
            <span data-lang-en>Automatic Weight Balancing by Credits</span>
          </p>
          <p class="text-zinc-400 leading-relaxed">
            <span data-lang-es>Si agregas o eliminas un parcial de la lista, SofiGrades redistribuye de forma inteligente el 100% entre las evaluaciones restantes sin descuadrar tu planilla.</span>
            <span data-lang-en>If you add or delete an exam, SofiGrades intelligently redistributes 100% among remaining evaluations without ruining your schedule.</span>
          </p>
        </div>

        <div class="space-y-2">
          <p class="font-bold text-white flex items-center gap-2">
            <span>🔥</span>
            <span data-lang-es>Racha de Sesiones de Estudio</span>
            <span data-lang-en>Daily Study Session Streaks</span>
          </p>
          <p class="text-zinc-400 leading-relaxed">
            <span data-lang-es>Haz check-in diario de tus horas de estudio para forzar el retorno cotidiano y llegar preparado antes de las semanas de finales.</span>
            <span data-lang-en>Check-in daily study sessions to build everyday discipline and arrive prepared for final exam weeks.</span>
          </p>
        </div>
      </div>
    </section>

    <!-- BANNER DE CONVERSIÓN FINAL -->
    <section class="bg-gradient-to-tr from-emerald-900 to-teal-950 rounded-[40px] p-8 md:p-14 text-center space-y-6 border border-emerald-500/30 shadow-2xl">
      <h2 class="text-3xl md:text-5xl font-black uppercase text-white">
        <span data-lang-es>Asegura tu Beca y Domina tus Notas Hoy</span>
        <span data-lang-en>Protect Your Scholarship and Master Your Grades Today</span>
      </h2>
      <p class="text-zinc-300 max-w-xl mx-auto text-base font-medium">
        <span data-lang-es>Únete a miles de estudiantes que eliminaron la ansiedad de exámenes y calculan su éxito académico de forma inteligente.</span>
        <span data-lang-en>Join thousands of students who eliminated exam stress and intelligently plan their academic success.</span>
      </p>

      <div class="flex flex-wrap justify-center gap-4 pt-4">
        <a href="https://appgallery.cloud.huawei.com/ag/n/app/C117722731" target="_blank" class="hover:scale-105 transition">
          <img src="/badges/huawei.png" alt="Huawei AppGallery" class="h-12 w-auto rounded-lg shadow-lg" />
        </a>
        <a href="https://www.amazon.com/gp/product/B0H1DM938C" target="_blank" class="hover:scale-105 transition">
          <img src="/badges/amazon.png" alt="Amazon Appstore" class="h-12 w-auto rounded-lg shadow-lg" />
        </a>
        <a href="https://apps.microsoft.com/store/detail/9P5G4FND54F4" target="_blank" class="hover:scale-105 transition">
          <img src="/badges/microsoft.png" alt="Microsoft Store" class="h-12 w-auto rounded-lg shadow-lg" />
        </a>

        <!-- GOOGLE PLAY EN PRUEBAS CERRADAS -->
        <div class="opacity-40 grayscale select-none cursor-help hover:opacity-60 transition duration-300" title="Próximamente en Google Play (Fase de Pruebas Cerradas)">
          <img src="/badges/google-play.png" alt="Get it on Google Play (Próximamente)" class="h-12 w-auto rounded-lg shadow-md" />
        </div>
      </div>
    </section>

    <!-- FOOTER TOTALMENTE AGNÓSTICO DE UBICACIÓN -->
    <footer class="pt-12 border-t border-zinc-800 flex flex-col md:flex-row justify-between items-center gap-6 text-xs text-zinc-500">
      <div class="space-y-1 text-center md:text-left">
        <p class="font-bold text-zinc-300">Copyright © 2026 appjava.dev. Todos los derechos reservados.</p>
        <p>SofiGrades es una marca registrada de appjava.dev.</p>
      </div>

      <div class="flex gap-6 font-bold uppercase tracking-wider text-zinc-400">
        <a href="/sofigrades/privacy" class="hover:text-white transition">
          <span data-lang-es>Política de Privacidad</span><span data-lang-en>Privacy Policy</span>
        </a>
        <a href="/" class="hover:text-white transition">appjava.dev</a>
      </div>
    </footer>

  </main>
</SofiLayout>

<script is:inline>
  function setupInteractiveFeatures() {
    const savedLang = localStorage.getItem('appjava_lang') || 'es';
    
    function updateUI(lang) {
      document.documentElement.setAttribute('data-lang', lang);
      document.querySelectorAll('.lang-btn').forEach(btn => {
        const target = btn.getAttribute('data-target');
        if (target === lang) {
          btn.classList.add('bg-emerald-600', 'text-white');
          btn.classList.remove('text-zinc-400');
        } else {
          btn.classList.remove('bg-emerald-600', 'text-white');
          btn.classList.add('text-zinc-400');
        }
      });
    }

    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-target');
        localStorage.setItem('appjava_lang', lang);
        updateUI(lang);
      });
    });

    updateUI(savedLang);

    // INTERACTIVIDAD DEL SIMULADOR
    const triggers = document.querySelectorAll('.screen-trigger');
    const screens = document.querySelectorAll('.screen-img');

    triggers.forEach(trigger => {
      const activateScreen = () => {
        const target = trigger.getAttribute('data-target');
        screens.forEach(s => s.classList.replace('opacity-100', 'opacity-0'));
        const targetScreen = document.getElementById(`screen-${target}`);
        if (targetScreen) targetScreen.classList.replace('opacity-0', 'opacity-100');

        triggers.forEach(t => {
          t.classList.remove('bg-white', 'text-zinc-950');
          t.classList.add('bg-white/10', 'text-white');
        });
        trigger.classList.remove('bg-white/10', 'text-white');
        trigger.classList.add('bg-white', 'text-zinc-950');
      };

      trigger.addEventListener('mouseenter', activateScreen);
      trigger.addEventListener('click', activateScreen);
    });
  }

  setupInteractiveFeatures();
</script>